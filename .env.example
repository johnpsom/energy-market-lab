# Copy to .env and fill in. .env is gitignored.

# ENTSO-E Transparency Platform API token (FREE).
# How to get it:
#   1. Register at https://transparency.entsoe.eu/  (free account)
#   2. Log in, then email transparency@entsoe.eu with subject "Restful API access"
#      and your account email in the body. They enable API access (usually < 3 days).
#   3. Account Settings -> "Web Api Security Token" -> Generate. Paste it below.
ENTSOE_TOKEN=

# Warehouse. Default = local SQLite (no setup). To upgrade later, point this at Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/eml
DATABASE_URL=sqlite:///data/eml.db

# Anchor bidding zone (ENTSO-E country code). GR = Greece.
DEFAULT_ZONE=GR
